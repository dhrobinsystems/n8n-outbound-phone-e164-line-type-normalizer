# n8n-outbound-phone-e164-line-type-normalizer
# Copy to .env for the CLI, or set the same variables in the n8n environment.
# Every value is a placeholder or a safe default. Never commit real values.

# --- HubSpot ---------------------------------------------------------------------
# Private app scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.schemas.contacts.write (only for `npm run properties:create`).
# While the token is a placeholder the workflow runs in demo mode (bundled fictional contacts, no network).
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_TOKEN_HERE
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: a portal ID that SANDBOX_MODE accepts even if its account type is not SANDBOX/DEVELOPER_TEST.
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID_HERE

# --- Webhook authentication ---------------------------------------------------------
# Random value of at least 24 characters, sent by the caller in WEBHOOK_SECRET_HEADER.
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
WEBHOOK_SECRET_HEADER=x-webhook-secret

# --- Carrier lookup ---------------------------------------------------------------
# mock (default): simulated line types, no cost, never allowed for live writes.
# twilio: Twilio Lookup v2 Line Type Intelligence (paid per lookup).
LOOKUP_PROVIDER=mock
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_LOOKUP_BASE_URL=https://lookups.twilio.com
MAX_LOOKUPS_PER_DAY=500
LOOKUP_CACHE_DAYS=90
# Testing against a stub lookup endpoint only. Not allowed in live mode.
LOOKUP_FICTIONAL_NUMBERS=false

# --- Safety switches (fail safe: only false/0/no/off turns them off) ----------------
DRY_RUN=true
SANDBOX_MODE=true

# --- Normalization ------------------------------------------------------------------
DEFAULT_COUNTRY=US
OVERWRITE_SOURCE_PHONE_FIELDS=false
SMS_ELIGIBLE_LINE_TYPES=mobile
DIAL_ELIGIBLE_LINE_TYPES=mobile,landline,fixed_voip,non_fixed_voip
MAX_LEADS_PER_REQUEST=100
# Optional JSON (single line) with phone fields and property names; see config.example.json.
NORMALIZER_CONFIG_JSON=YOUR_NORMALIZER_CONFIG_JSON_HERE

# --- Audit and alerts ---------------------------------------------------------------
# Optional HTTPS endpoints. Audit events carry masked numbers only; alerts are redacted.
AUDIT_WEBHOOK_URL=YOUR_AUDIT_WEBHOOK_URL_HERE
ALERT_WEBHOOK_URL=YOUR_ALERT_WEBHOOK_URL_HERE

# --- Manual runs in HubSpot mode ------------------------------------------------------
MANUAL_TEST_CONTACT_IDS=YOUR_SANDBOX_CONTACT_IDS_HERE

# --- Testing only ---------------------------------------------------------------------
# Pins the clock (ISO 8601). Leave empty in production.
NORMALIZER_NOW=

# --- n8n host settings (set on the n8n instance) --------------------------------------
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false   lets Code nodes and expressions read $env
